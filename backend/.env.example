# =============================================================================
# LacedUp - Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to `.env` in this directory (backend/) and fill in real values.
#   cd backend && cp .env.example .env
# `.env` is git-ignored and must never be committed.
# =============================================================================


# --- Server ------------------------------------------------------------------

# Port the Express server listens on.
# Optional - app.js falls back to 3000 if unset.
PORT=3000

# Environment name. Set to `production` in deployment.
# Anything other than `production` enables the dev-only price consistency
# checker (common/middlewares/price-consistency-check.middleware.ts), and is
# what gates request/response body logging - those bodies include plaintext
# passwords, so they must never reach a hosting provider's log store.
NODE_ENV=development

# Reverse proxy hops in front of Express, for resolving the visitor's real IP.
# 0 locally (no proxy), 1 behind Render alone, 2 with Vercel rewriting to it.
# Wrong here means every visitor shares one rate-limit bucket - GET /healthz
# echoes the IP this resolves to, and it should be the visitor's.
TRUST_PROXY=0


# --- Database (required) -----------------------------------------------------

# MongoDB connection string. Also backs the express-session store
# (connect-mongo), so the app exits on startup if this is missing or wrong.
# Local:  mongodb://127.0.0.1:27017/lacedup
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lacedup
MONGODB_URI=mongodb://127.0.0.1:27017/lacedup


# --- Sessions ----------------------------------------------------------------

# Secret used to sign session cookies.
# app.js falls back to the hardcoded string 'yourSecretKey' if unset - fine for
# local dev, but MUST be set to a long random value in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=


# --- JWT authentication ------------------------------------------------------

# Signs the access token. REQUIRED - the app refuses to issue a login without it.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Signs the refresh token. Optional: falls back to JWT_SECRET when unset, but a
# separate value means a leaked access-token secret cannot mint refresh tokens.
JWT_REFRESH_SECRET=


# --- Google OAuth login ------------------------------------------------------

# From https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must be: http://localhost:3000/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where Google returns the browser after consent.
# Leave blank locally: the path is resolved against the requesting host, which
# is the host you are on. Set it in a split deployment, where it must be the
# PUBLIC origin (the Vercel domain) rather than the API host - otherwise the
# login cookie is set on a domain the app is not served from. Whatever is set
# here must also be an authorised redirect URI in the Google console, verbatim.
#   https://<your-app>.vercel.app/google/callback
GOOGLE_CALLBACK_URL=

# Facebook login - the strategy is currently commented out in
# config/passport.js. Only needed if you re-enable it.
FB_CLIENT_ID=
FB_CLIENT_SECRET=


# --- Image storage --------------------------------------------------------

# Where uploaded images go.
#
# Unset means the local filesystem, under backend/public/uploads - which is
# what development and the test suite use, and needs no account.
#
# Set it and every upload goes to Cloudinary instead. Required in any
# deployment on an ephemeral filesystem (Render included): files written to
# disk there do not survive a restart, and the database is left holding URLs
# that 404.
#
# Copy it from the Cloudinary console dashboard, 'API Environment variable':
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
# Migrate the images that predate it with: npm run migrate:images
CLOUDINARY_URL=

# Root folder in the media library. Everything is filed under
# <root>/products, <root>/brands, <root>/categories, <root>/reviews and
# <root>/profiles, so one account can host more than one project.
CLOUDINARY_FOLDER=lacedup


# --- Payments: Razorpay ------------------------------------------------------

# From https://dashboard.razorpay.com/app/website-app-settings/api-keys
# KEY_ID is also passed to the browser to open the Razorpay checkout widget.
# KEY_SECRET signs/verifies payments server-side - keep it server-only.
# Test keys start with `rzp_test_`.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=


# --- Payments: PayPal --------------------------------------------------------

# From https://developer.paypal.com/dashboard/applications/sandbox
# services/paymentProviders/paypal.js is hardcoded to SandboxEnvironment,
# so use sandbox credentials unless you switch it to LiveEnvironment.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=


# --- Email / OTP -------------------------------------------------------------

# Gmail SMTP credentials used for OTP and transactional email (utils/sendEmail.js).
# EMAIL_PASS must be a Google *App Password* (16 chars, 2FA required),
# not your normal account password.
# If EMAIL_USER is empty the app automatically falls back to the mock email
# sender, which prints the OTP to the console instead of sending it.
EMAIL_USER=
EMAIL_PASS=

# Force the mock email sender even when real credentials are present.
# Set to `true` to print OTPs to the console during development.
MOCK_EMAIL=false

# When mocking, also append each email to logs/mock-emails.log.
# Set to `true` to enable.
MOCK_EMAIL_LOG=false


# --- Geoapify (address autocomplete) -----------------------------------------

# From https://myprojects.geoapify.com/
# Exposed to EJS templates for the address autocomplete widget on the
# address book and checkout pages, so it is public by design - restrict it to
# your domains in the Geoapify dashboard.
GEOAPIFY_API_KEY=
